    "supervisor": "src/agent/multi-agent-supervisor.mjs",
    "composition": "src/agent/agent-system.mjs",
    "profileCount": 5,
    "defaultMaxAgents": 3,
    "sequentialExecution": true,
    "sharedToolBudget": true,
    "perAgentToolPermissions": "intersection of agent profile, skill policy and caller allowlist"
  },
  "mcp": {
    "adapter": "src/agent/skill-mcp-resources.mjs",
    "mode": "read-only resources/list and resources/read",
    "authorization": "mandatory callback; no public default",
    "toolsExposed": false,
    "writeOperations": false,
    "httpEndpointExposed": false
  },
  "providerAgentRuntime": {
    "planner": "src/agent/provider-agent-planner.mjs",
    "runtime": "src/agent/provider-agent-runtime.mjs",
    "providerPoolEntry": "runConfiguredProviderCompletion",
    "internalEntry": "runCEOAIInternalAgentTask",
    "providerReuse": "existing CEOAI provider pool, model selection, cooldown and quota failover",
    "maxModelCallsPerTask": 4,
    "defaultSynthesis": true,
    "toolExecution": "requires explicit approval and caller allowlist",
    "httpRoute": false,
    "paidProvidersAdded": false
  },
  "applicationAgentGateway": {
    "endpoint": "POST /v1/agents/run",
    "authentication": "HMAC-SHA256 via existing verifyHmacSignature and SecurityOrchestratorDO nonce replay protection",
    "applications": {
      "CONTENTCRAFT-APP": {
        "maxAgents": 2,
        "maxModelCalls": 3
      },
      "AIFORCE-APP": {
        "maxAgents": 3,
        "maxModelCalls": 4
      }
    },
    "rateLimit": "existing RATE_LIMITER binding, fail closed",
    "maxBodyBytes": 8192,
    "maxTaskCharacters": 2000,
    "maxInputBytes": 4000,
    "tools": "disabled; empty tool registry; no external side effects",
