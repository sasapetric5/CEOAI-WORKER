  "rollout_phases": [
    {
      "phase": 1,
      "name": "Foundation and representative pilot",
      "candidate_target": 50,
      "verified_target": 25,
      "runtime_enabled_target": 0,
      "exit_criteria": [
        "registry schema and duplicate checks pass",
        "provenance and license recorded",
        "security review complete",
        "tests pass locally/in CI",
        "no paid service or external-action dependency"
      ]
    },
    {
      "phase": 2,
      "name": "Core coverage",
      "candidate_target": 250,
      "verified_target": 150,
      "runtime_enabled_target": 25,
      "exit_criteria": [
        "four application groups covered",
        "skill selection and output contracts tested",
        "runtime enablement is explicit and least-privilege"
      ]
    },
    {
      "phase": 3,
      "name": "Broad library",
      "candidate_target": 600,
      "verified_target": 400,
      "runtime_enabled_target": 100,
      "exit_criteria": [
        "deduplication and quality scoring operational",
        "retrieval latency/context budget measured",
        "failure and fallback behavior tested"
      ]
    },
    {
      "phase": 4,
      "name": "Initial 1,000-skill target",
      "candidate_target": 1000,
      "verified_target": 800,
      "runtime_enabled_target": 200,
      "exit_criteria": [
        "candidate inventory reaches 1000",
        "at least 800 have completed review and tests",
        "runtime-enabled subset individually approved",
        "coverage gaps and rejected candidates documented"
      ]
    }
  ],
  "quality_score": {
    "scale": "0-100",
    "dimensions": [
      {
        "id": "task_fit",
        "weight": 25
      },
      {
        "id": "correctness_and_test_evidence",
        "weight": 20
      },
      {
        "id": "security_and_permissions",
        "weight": 20
      },
      {
        "id": "license_and_provenance",
        "weight": 15
      },
      {
        "id": "portability_and_dependencies",
        "weight": 10
      },
      {
        "id": "maintainability_and_freshness",
        "weight": 10
      }
    ],
    "gate": "A high score never overrides a failed license, security, free-only, or owner-approval gate."
  },
  "intake_record_required_fields": [
    "id",
    "name",
    "description",
    "category",
    "tags",
    "intents",
    "input_contract",
    "output_contract",
    "source_repository",
    "source_commit_sha",
    "source_path",
    "content_hash",
    "license_status",
    "attribution",
    "dependencies",
    "network_requirements",
    "secret_requirements",
    "risk_level",
    "security_status",
    "test_status",
    "runtime_status",
    "reviewed_at",
    "review_notes"
  ],
  "first_batch_priorities": [
    "software-engineering-and-testing",
    "security-and-privacy",
    "agent-orchestration-and-quality",
    "seo-and-site-auditing",
    "research-and-sources",
    "content-and-marketing"
  ],
  "measurement": {
    "report_separately": [
      "candidate_count",
      "reviewed_count",
      "verified_count",
      "runtime_enabled_count",
      "rejected_count",
      "duplicate_count"
    ],
    "never_conflate_catalogued_with_verified": true,
    "never_conflate_verified_with_runtime_enabled": true
  }
}
