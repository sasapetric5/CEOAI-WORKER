{
  "schema_version": "1.0.0",
  "plan_id": "ceoai-1000-skill-library",
  "target_skill_count": 1000,
  "status": "intake-plan",
  "created_for_branch": "v5.0",
  "policy": {
    "free_only": true,
    "auto_import": false,
    "auto_execute": false,
    "load_all_skills_per_task": false,
    "max_skills_per_task_default": 4,
    "max_skills_per_task_hard_limit": 8,
    "third_party_content_requires_provenance": true,
    "skill_level_license_review_required": true,
    "security_review_required": true,
    "deduplication_required": true,
    "tests_required_before_runtime_enable": true,
    "explicit_owner_approval_before_runtime_enable": true,
    "paid_services_enabled": false,
    "external_actions_enabled": false
  },
  "counting_rules": [
    "Count a skill only when it has a unique stable ID and a concrete, non-duplicative capability.",
    "A repository, agent profile, MCP server, prompt list, or link is not automatically a skill.",
    "A candidate is not a verified skill until provenance, license, security, compatibility, and tests are recorded.",
    "Do not copy third-party skill content when license terms are unknown or incompatible; retain discovery metadata instead.",
    "Do not claim that target counts are current inventory counts."
  ],
  "category_targets": [
    {
      "id": "software-engineering-and-testing",
      "target": 180,
      "apps": [
        "CEOAI",
        "Safe Automaton"
      ],
      "focus": [
        "coding",
        "debugging",
        "refactoring",
        "TDD",
        "unit and integration tests",
        "code review",
        "API contracts"
      ]
    },
    {
